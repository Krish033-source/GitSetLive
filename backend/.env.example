# Copy to backend/.env and fill in. Never commit the real file.

# --- GitHub OAuth app: https://github.com/settings/developers -> New OAuth App
# Authorization callback URL must be:  <this backend's public URL>/callback   (local: http://localhost:5000/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Security (required) ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Encrypts GitHub tokens + env vars at rest. python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Strongly recommended in production (if empty, a key file is created in DATA_DIR).
ENCRYPTION_KEY=

# --- URLs / CORS ---
FRONTEND_URL=http://localhost:3000
# extra allowed origins, comma separated (optional)
ALLOWED_ORIGINS=

# --- AI (Groq: https://console.groq.com/keys) ---
GROQ_API_KEY=
# preference order; retired models are skipped automatically. Default: openai/gpt-oss-120b,qwen/qwen3.6-27b,openai/gpt-oss-20b
GROQ_MODELS=

# --- Optional: invitation emails (Gmail: use an App Password) ---
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- Runtime ---
ENV=development            # set to "production" when deployed
DATA_DIR=                  # where app.db lives. Use a persistent disk in production, e.g. /data
SESSION_DAYS=14

# --- "Our Servers" deploy engine (runs user code on this machine - read the README first) ---
OWN_SERVER_ENABLED=        # default: true in development, false in production
OWN_SERVER_TTL_MINUTES=120
OWN_SERVER_MAX_PER_USER=3
OWN_SERVER_MAX_TOTAL=20
CLOUDFLARED_PATH=
